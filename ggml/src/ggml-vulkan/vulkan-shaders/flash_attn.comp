#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#ifdef FLOAT16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#endif

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_shader_subgroup_vote : enable

#include "types.glsl"
#include "flash_attn_base.glsl"

const uint32_t row_split = (Br < 4) ? 1 : 4;
const uint32_t rows_per_thread = Br / row_split;
const uint32_t cols_per_iter = WorkGroupSize / row_split;
const uint32_t cols_per_thread = Bc / cols_per_iter;
const uint32_t num_subgroups = WorkGroupSize / SubGroupSize;

const uint32_t nbatch_K = (HSK < 128) ? HSK : (HSK % 128 == 0 ? 128 : 64);
const uint32_t nbatch_V_raw = (nbatch_K * Bc) / HSV > cols_per_iter ? (nbatch_K * Bc) / HSV : cols_per_iter;
const uint32_t nbatch_V = nbatch_V_raw >= Bc   ? Bc   :
                          nbatch_V_raw >= Bc/2 ? Bc/2 :
                          nbatch_V_raw >= Bc/4 ? Bc/4 :
                          cols_per_iter;

const uint32_t batch_K_elems = nbatch_K / 4;
const uint32_t batch_V_rows = nbatch_V / cols_per_iter;
const bool hsv4_is_pow2 = ((HSV/4) & ((HSV/4) - 1)) == 0;

layout (binding = 0) readonly buffer Q {float data_q[];};
layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer K {float16_t data_k[];};
layout (binding = 1) readonly buffer KV4 {f16vec4 data_kv4[];};
layout (binding = 2) readonly buffer V {float16_t data_v[];};
layout (binding = 2) readonly buffer VV4 {f16vec4 data_vv4[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};

// If SubGroupSize is set to 0xFFFFFFFF then only use shmem reductions
const uint32_t tmpsh_size = (SubGroupSize == SUBGROUPS_DISABLED) ? WorkGroupSize : num_subgroups;
shared float tmpsh[tmpsh_size];
shared ACC_TYPEV4 tmpsh_accv4[hsv4_is_pow2 ? tmpsh_size : WorkGroupSize];

const uint32_t masksh_stride = Br + 1;
shared FLOAT_TYPE masksh[Bc * masksh_stride];

const uint32_t qf_stride = HSK / 4 + 1;
shared FLOAT_TYPEV4 Qf[Br * qf_stride];

const uint32_t kvsh_K_stride = nbatch_K / 4 + 1;
const uint32_t kvsh_V_stride = HSV / 4 + 1;
const uint32_t kvsh_K_size = Bc * kvsh_K_stride;
const uint32_t kvsh_V_size = nbatch_V * kvsh_V_stride;
shared FLOAT_TYPEV4 kvsh[SHMEM_STAGING != 0 ? (kvsh_K_size > kvsh_V_size ? kvsh_K_size : kvsh_V_size) : 1];

const uint32_t pfsh_stride = Br + 1;
shared FLOAT_TYPE Pfsh[Bc * pfsh_stride];

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    init_indices();

    const uint32_t tid = gl_LocalInvocationIndex;
    const uint32_t threads_per_rowgroup = gl_WorkGroupSize.x / row_split;
    const uint32_t row_tid = gl_LocalInvocationIndex / threads_per_rowgroup;
    const uint32_t rowgroup_tid = gl_LocalInvocationIndex % threads_per_rowgroup;

    const uint32_t cols_per_thread_kq = (Bc + threads_per_rowgroup - 1) / threads_per_rowgroup;
    const uint32_t d_tid_v = rowgroup_tid % (HSV / 4);
    const uint32_t np_id = rowgroup_tid / (HSV / 4);
    const uint32_t np = threads_per_rowgroup >= HSV / 4 ? (threads_per_rowgroup / (HSV / 4)) : 1;
    const uint32_t of_elements = (HSV / 4 + threads_per_rowgroup - 1) / threads_per_rowgroup;
    const bool of_bounds_check = ((HSV / 4) % threads_per_rowgroup) != 0;
    const uint32_t num_sg_per_rg = threads_per_rowgroup / SubGroupSize;

#define tile_row(r) (row_tid * rows_per_thread + (r))

    uint32_t q_offset = gqa_iq1*p.nb01 + (iq2*p.nb02 + iq3*p.nb03) / 4;

    [[unroll]] for (uint32_t idx = 0; idx < Br * HSK / 4; idx += gl_WorkGroupSize.x) {
        uint32_t d = (idx + tid) % (HSK / 4);
        uint32_t r = (idx + tid) / (HSK / 4);
        if (r < Br && d < HSK / 4 &&
            i * Br + r < N) {
            Qf[r * qf_stride + d] = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d] * p.scale);
        }
    }
    barrier();

    ACC_TYPEV4 Of[rows_per_thread][of_elements];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
            Of[r][d] = ACC_TYPEV4(0.0);
        }
    }

    float Lf[rows_per_thread], Mf[rows_per_thread];

    // Use -FLT_MAX/2 rather than -inf to reduce the possibility of NaNs, e.g. when computing Mold-M.
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = 0;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    ACC_TYPE slope[rows_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        slope[r] = ACC_TYPE(1.0);
    }

    // ALiBi
    if (p.max_bias > 0.0f) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            slope[r] = perElemOpComputeSlope(tile_row(r), 0, ACC_TYPE(0), iq2);
        }
    }

    const uint32_t mo_stride = CEIL_DIV(KV, 16 * Bc);
    // mo_offset will point to the tile starting at row i*Br and col 0
    uint32_t mo_offset = mo_stride * i;

#if BLOCK_SIZE > 1
    uint32_t k_offset = (ik2*p.nb12 + ik3*p.nb13) / BLOCK_BYTE_SIZE;
    uint32_t v_offset = (iv2*p.nb22 + iv3*p.nb23) / BLOCK_BYTE_SIZE;
#else
    uint32_t k_offset = (ik2*p.nb12 + ik3*p.nb13) / 2;
    uint32_t v_offset = (iv2*p.nb22 + iv3*p.nb23) / 2;
#endif
    uint32_t m_offset = gqa_iq1*KV;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
        mo_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * CEIL_DIV(p.nem1, Br) * mo_stride;
    }

    uint32_t mask_opt = 0;
    uint32_t mask_opt_idx = ~0;
    uint32_t mask_opt_bits = 0;

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {
        if (MASK_ENABLE) {
            if (USE_MASK_OPT && mask_opt_idx != j / 16) {
                mask_opt_idx = j / 16;
                mask_opt = data_mask_opt[mo_offset + mask_opt_idx];
            }
            mask_opt_bits = (mask_opt >> ((j % 16) * 2)) & 0x3;
            if (mask_opt_bits == MASK_OPT_ALL_NEG_INF) {
                // skip this block
                continue;
            }
            // Only load if the block is not all zeros
            if (mask_opt_bits != MASK_OPT_ALL_ZERO) {
                bool nem1_bounds_check = !(p.gqa_ratio > 1) && (p.nem1 % Br) != 0;

                barrier();
                [[unroll]] for (uint32_t idx = 0; idx < Bc * Br; idx += gl_WorkGroupSize.x) {
                    uint32_t c = (idx + tid) % Bc;
                    uint32_t r = (idx + tid) / Bc;
                    if (idx + tid < Bc * Br) {
                        if ((!KV_bounds_check || j * Bc + c < KV) && (!nem1_bounds_check || i * Br + r < p.nem1)) {
                            float m = float(data_m[m_offset + (i * Br + r) * m_stride + (j * Bc + c)]);
                            masksh[c * masksh_stride + r] = FLOAT_TYPE(m);
                        } else {
                            masksh[c * masksh_stride + r] = FLOAT_TYPE(0);
                        }
                    }
                }
                barrier();
            }
        }

        ACC_TYPE Sf[rows_per_thread][cols_per_thread_kq];
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread_kq; ++c) {
                Sf[r][c] = ACC_TYPE(0.0);
            }
        }

        if (SHMEM_STAGING != 0) {
            // Chunk shmem loads into nbatch_K-sized blocks
            [[dont_unroll]]
            for (uint32_t kbatch_offset = 0; kbatch_offset < HSK; kbatch_offset += nbatch_K) {
                barrier();
                [[unroll]] for (uint32_t idx = 0; idx < Bc * nbatch_K / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t d = (idx + tid) % (nbatch_K / 4);
                    uint32_t c = (idx + tid) / (nbatch_K / 4);
                    if (c < Bc) {
                        FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                        if (!KV_bounds_check || j * Bc + c < KV) {
#if BLOCK_SIZE > 1
                            uint coord = (j * Bc + c) * k_stride * BLOCK_SIZE + kbatch_offset + 4 * d;
                            uint ib = coord / BLOCK_SIZE;
                            uint iqs = (coord % BLOCK_SIZE);
                            K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
#else
                            K_Tf = FLOAT_TYPEV4(data_kv4[(k_offset + (j * Bc + c) * k_stride + kbatch_offset) / 4 + d]);
#endif
                        }

                        kvsh[c * kvsh_K_stride + d] = K_Tf;
                    }
                }
                barrier();

                [[unroll]] for (uint32_t d = 0; d < nbatch_K / 4; ++d) {
                    const uint32_t global_d = kbatch_offset / 4 + d;

                    FLOAT_TYPEV4 Q_cache[rows_per_thread];
                    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                        Q_cache[r] = Qf[tile_row(r) * qf_stride + global_d];
                    }

                    [[unroll]] for (uint32_t c = 0; c < cols_per_thread_kq; ++c) {
                        const uint32_t kv_col = c * threads_per_rowgroup + rowgroup_tid;
                        if ((KV_bounds_check && j * Bc + kv_col >= KV) || kv_col >= Bc) {
                            continue;
                        }

                        const FLOAT_TYPEV4 K_Tf = kvsh[kv_col * kvsh_K_stride + d];
                        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                            Sf[r][c] += ACC_TYPE(dot(Q_cache[r], K_Tf));
                        }
                    }
                }
            }
        } else {
            // Just load directly from global memory
            [[unroll]] for (uint32_t d = 0; d < HSK / 4; ++d) {
                FLOAT_TYPEV4 Q_cache[rows_per_thread];
                [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                    Q_cache[r] = Qf[tile_row(r) * qf_stride + d];
                }

                [[unroll]] for (uint32_t c = 0; c < cols_per_thread_kq; ++c) {
                    const uint32_t kv_col = c * threads_per_rowgroup + rowgroup_tid;
                    if ((KV_bounds_check && j * Bc + kv_col >= KV) || kv_col >= Bc) {
                        continue;
                    }

                    FLOAT_TYPEV4 K_Tf;
#if BLOCK_SIZE > 1
                    uint coord = (j * Bc + kv_col) * k_stride * BLOCK_SIZE + 4 * d;
                    uint ib = coord / BLOCK_SIZE;
                    uint iqs = (coord % BLOCK_SIZE);
                    K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
#else
                    K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + (j * Bc + kv_col) * k_stride / 4 + d]);
#endif
                    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                        Sf[r][c] += ACC_TYPE(dot(Q_cache[r], K_Tf));
                    }
                }
            }
        }

        if (LOGIT_SOFTCAP) {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                [[unroll]] for (uint32_t c = 0; c < cols_per_thread_kq; ++c) {
                    Sf[r][c] = ACC_TYPE(p.logit_softcap * tanh(Sf[r][c]));
                }
            }
        }

        if (MASK_ENABLE && mask_opt_bits != MASK_OPT_ALL_ZERO) {
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread_kq; ++c) {
                const uint32_t kv_col = c * threads_per_rowgroup + rowgroup_tid;
                if (kv_col >= Bc) continue;
                [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                    FLOAT_TYPE mvf = masksh[kv_col * masksh_stride + tile_row(r)];

                    Sf[r][c] += slope[r]*mvf;
                }
            }
        }

        float eMf[rows_per_thread];
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            float rowmaxf = NEG_FLT_MAX_OVER_2;
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread_kq; ++c) {
                const uint32_t kv_col = c * threads_per_rowgroup + rowgroup_tid;
                if ((KV_bounds_check && j * Bc + kv_col >= KV) || kv_col >= Bc) {
                    continue;
                }
                rowmaxf = max(rowmaxf, float(Sf[r][c]));
            }

            if (SubGroupSize == SUBGROUPS_DISABLED) {
                barrier();
                tmpsh[row_tid * threads_per_rowgroup + rowgroup_tid] = rowmaxf;
                barrier();
                for (uint32_t s = threads_per_rowgroup / 2; s > 0; s >>= 1) {
                    if (rowgroup_tid < s) {
                        rowmaxf = max(rowmaxf, tmpsh[row_tid * threads_per_rowgroup + rowgroup_tid + s]);
                        tmpsh[row_tid * threads_per_rowgroup + rowgroup_tid] = rowmaxf;
                    }
                    barrier();
                }
                rowmaxf = tmpsh[row_tid * threads_per_rowgroup];
            } else if (threads_per_rowgroup == SubGroupSize) {
                rowmaxf = subgroupMax(rowmaxf);
            } else if (threads_per_rowgroup < SubGroupSize) {
                [[unroll]] for (uint32_t s = threads_per_rowgroup / 2; s > 0; s >>= 1) {
                    rowmaxf = max(rowmaxf, subgroupShuffleXor(rowmaxf, s));
                }
            } else {
                rowmaxf = subgroupMax(rowmaxf);
                barrier();
                if (gl_SubgroupInvocationID == 0) {
                    tmpsh[gl_SubgroupID] = rowmaxf;
                }
                barrier();
                rowmaxf = tmpsh[row_tid * num_sg_per_rg + (rowgroup_tid % num_sg_per_rg)];
                rowmaxf = subgroupMax(rowmaxf);
            }

            float Moldf = Mf[r];

            // M = max(rowmax, Mold)
            // P = e^(S - M)
            // eM = e^(Mold - M)
            Mf[r] = max(rowmaxf, Moldf);
            eMf[r] = exp(Moldf - Mf[r]);
            Lf[r] = eMf[r]*Lf[r];
        }

        barrier();
        float Lf_acc[rows_per_thread];
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            Lf_acc[r] = 0.0f;
        }

        [[unroll]] for (uint32_t c = 0; c < cols_per_thread_kq; ++c) {
            const uint32_t kv_col = c * threads_per_rowgroup + rowgroup_tid;
            if (kv_col >= Bc) continue;
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                FLOAT_TYPE Pf_val = FLOAT_TYPE(0);
                if (!KV_bounds_check || j * Bc + kv_col < KV) {
                    Pf_val = FLOAT_TYPE(exp(float(Sf[r][c]) - Mf[r]));
                    Lf_acc[r] += Pf_val;
                }
                Pfsh[kv_col * pfsh_stride + tile_row(r)] = Pf_val;
            }
        }

        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (SubGroupSize == SUBGROUPS_DISABLED) {
                barrier();
                tmpsh[row_tid * threads_per_rowgroup + rowgroup_tid] = Lf_acc[r];
                barrier();
                for (uint32_t s = threads_per_rowgroup / 2; s > 0; s >>= 1) {
                    if (rowgroup_tid < s) {
                        Lf_acc[r] += tmpsh[row_tid * threads_per_rowgroup + rowgroup_tid + s];
                        tmpsh[row_tid * threads_per_rowgroup + rowgroup_tid] = Lf_acc[r];
                    }
                    barrier();
                }
                Lf_acc[r] = tmpsh[row_tid * threads_per_rowgroup];
            } else if (threads_per_rowgroup == SubGroupSize) {
                Lf_acc[r] = subgroupAdd(Lf_acc[r]);
            } else if (threads_per_rowgroup < SubGroupSize) {
                [[unroll]] for (uint32_t s = threads_per_rowgroup / 2; s > 0; s >>= 1) {
                    Lf_acc[r] += subgroupShuffleXor(Lf_acc[r], s);
                }
            } else {
                Lf_acc[r] = subgroupAdd(Lf_acc[r]);
                barrier();
                if (gl_SubgroupInvocationID == 0) {
                    tmpsh[gl_SubgroupID] = Lf_acc[r];
                }
                barrier();
                Lf_acc[r] = tmpsh[row_tid * num_sg_per_rg + (rowgroup_tid % num_sg_per_rg)];
                [[unroll]] for (uint32_t s = num_sg_per_rg / 2; s > 0; s >>= 1) {
                    Lf_acc[r] += subgroupShuffleXor(Lf_acc[r], s);
                }
            }
            Lf[r] += Lf_acc[r];
        }

        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                Of[r][d] = ACC_TYPE(eMf[r]) * Of[r][d];
            }
        }

        if (SHMEM_STAGING != 0) {
            [[dont_unroll]]
            for (uint32_t vbatch_offset = 0; vbatch_offset < Bc; vbatch_offset += nbatch_V) {
                barrier();
                [[unroll]] for (uint32_t idx = 0; idx < nbatch_V * HSV / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t d = (idx + tid) % (HSV / 4);
                    uint32_t c = (idx + tid) / (HSV / 4);
                    if (vbatch_offset + c < Bc) {
                        FLOAT_TYPEV4 V_Tf = FLOAT_TYPEV4(0);
                        if (!KV_bounds_check || j * Bc + vbatch_offset + c < KV) {
    #if BLOCK_SIZE > 1
                            uint coord = (j * Bc + vbatch_offset + c) * v_stride * BLOCK_SIZE + 4 * d;
                            uint ib = coord / BLOCK_SIZE;
                            uint iqs = (coord % BLOCK_SIZE);
                            V_Tf = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
    #else
                            V_Tf = FLOAT_TYPEV4(data_vv4[v_offset / 4 + (j * Bc + vbatch_offset + c) * v_stride / 4 + d]);
    #endif
                        }

                        kvsh[c * kvsh_V_stride + d] = V_Tf;
                    }
                }
                barrier();

                [[unroll]] for (uint32_t v = np_id; v < nbatch_V; v += np) {
                    const uint32_t global_c = vbatch_offset + v;
                    if (KV_bounds_check && j * Bc + global_c >= KV) {
                        continue;
                    }

                    FLOAT_TYPE Pf[rows_per_thread];
                    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                        Pf[r] = Pfsh[global_c * pfsh_stride + tile_row(r)];
                    }

                    [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                        if (!of_bounds_check || d * threads_per_rowgroup + d_tid_v < HSV / 4) {
                            const FLOAT_TYPEV4 Vf = kvsh[v * kvsh_V_stride + d * threads_per_rowgroup + d_tid_v];
                            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                                Of[r][d] += ACC_TYPEV4(Pf[r] * Vf);
                            }
                        }
                    }
                }
            }
        } else {
            barrier();
            [[unroll]] for (uint32_t v = np_id; v < Bc; v += np) {
                if (KV_bounds_check && j * Bc + v >= KV) {
                    continue;
                }

                FLOAT_TYPE Pf[rows_per_thread];
                [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                    Pf[r] = Pfsh[v * pfsh_stride + tile_row(r)];
                }

                [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                    if (!of_bounds_check || d * threads_per_rowgroup + d_tid_v < HSV / 4) {
                        FLOAT_TYPEV4 Vf;
#if BLOCK_SIZE > 1
                        uint coord = (j * Bc + v) * v_stride * BLOCK_SIZE + 4 * (d * threads_per_rowgroup + d_tid_v);
                        uint ib = coord / BLOCK_SIZE;
                        uint iqs = (coord % BLOCK_SIZE);
                        Vf = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
#else
                        Vf = FLOAT_TYPEV4(data_vv4[v_offset / 4 + (j * Bc + v) * v_stride / 4 + d * threads_per_rowgroup + d_tid_v]);
#endif
                        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                            Of[r][d] += ACC_TYPEV4(Pf[r] * Vf);
                        }
                    }
                }
            }
        }
    }

    if (np > 1) {
        if (SubGroupSize != SUBGROUPS_DISABLED && threads_per_rowgroup <= SubGroupSize && hsv4_is_pow2) {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                    [[unroll]] for (uint32_t s = HSV/4; s < threads_per_rowgroup; s *= 2) {
                        Of[r][d] += subgroupShuffleXor(Of[r][d], s);
                    }
                }
            }
        } else if (SubGroupSize != SUBGROUPS_DISABLED && hsv4_is_pow2) {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                    [[unroll]] for (uint32_t s = HSV/4; s < SubGroupSize; s *= 2) {
                        Of[r][d] += subgroupShuffleXor(Of[r][d], s);
                    }
                    barrier();
                    if (gl_SubgroupInvocationID == 0) {
                        tmpsh_accv4[gl_SubgroupID] = Of[r][d];
                    }
                    barrier();
                    Of[r][d] = tmpsh_accv4[row_tid * num_sg_per_rg + (rowgroup_tid % num_sg_per_rg)];
                    [[unroll]] for (uint32_t s = num_sg_per_rg / 2; s > 0; s >>= 1) {
                        Of[r][d] += subgroupShuffleXor(Of[r][d], s);
                    }
                }
            }
        } else {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                    barrier();
                    if (np_id > 0) {
                        tmpsh_accv4[row_tid * threads_per_rowgroup + rowgroup_tid] = Of[r][d];
                    }
                    barrier();
                    if (np_id == 0) {
                        [[unroll]] for (uint32_t p = 1; p < np; ++p) {
                            Of[r][d] += tmpsh_accv4[row_tid * threads_per_rowgroup + d_tid_v + p * (HSV/4)];
                        }
                    }
                }
            }
        }
    }

    // If there is split_k, then the split_k resolve shader does the final
    // division by L. Store the intermediate O value and per-row m and L values.
    if (p.k_num > 1) {
        if (np_id > 0) return;

        if (p.gqa_ratio > 1) {
            // note: O and Q have swapped coord 1,2.
            uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3)) / 4;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);
                if (row < N) {
                    [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                        if (!of_bounds_check || d * threads_per_rowgroup + d_tid_v < HSV / 4) {
                            gqaStore(row, d * threads_per_rowgroup + d_tid_v, Of[r][d], o_offset, iq2, N);
                        }
                    }
                }
            }

            o_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3));
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);
                if (row < N) {
                    perElemOpStoreCol0(row, 0u, ACC_TYPE(Lf[r]), o_offset, iq2, N);
                    perElemOpStoreCol0(row, 0u, ACC_TYPE(Mf[r]), o_offset + p.ne1, iq2, N);
                }
            }
        } else {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);
                const uint global_row = i * Br + row;

                if (global_row < N) {
                    uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3)) / 4;

                    [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                        if (!of_bounds_check || d * threads_per_rowgroup + d_tid_v < HSV / 4) {
                            data_ov4[o_offset + iq2 * HSV/4 + d * threads_per_rowgroup + d_tid_v] = D_TYPEV4(Of[r][d]);
                        }
                    }

                    if (rowgroup_tid == 0) {
                        uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3));
                        data_o[lm_offset + iq2] = D_TYPE(Lf[r]);
                        data_o[lm_offset + p.ne1 + iq2] = D_TYPE(Mf[r]);
                    }
                }
            }
        }
        return;
    }

    if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            float sink = perElemOpGetSink(tile_row(r), 0u, ACC_TYPE(0), iq2);

            float ms = 1.0f;
            float vs = 1.0f;

            if (sink > Mf[r]) {
                ms = exp(Mf[r] - sink);

                [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                    Of[r][d] *= ACC_TYPE(ms);
                }
            } else {
                vs = exp(sink - Mf[r]);
            }

            Lf[r] = Lf[r]*ms + vs;
        }
    }

    float Lfrcp[rows_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lfrcp[r] = (Lf[r] == 0.0) ? 0.0 : (1.0 / Lf[r]);
    }

    [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            Of[r][d] *= ACC_TYPE(Lfrcp[r]);
#if defined(ACC_TYPE_MAX)
            Of[r][d] = clamp(Of[r][d], -ACC_TYPE_MAX, ACC_TYPE_MAX);
#endif
        }
    }

    uint32_t o_offset = (gqa_iq1*p.ne1*HSV + iq3*p.ne2*p.ne1*HSV) / 4;

    if (np_id > 0) return;

    if (p.gqa_ratio > 1) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint row = tile_row(r);
            if (row < N) {
                [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                    if (!of_bounds_check || d * threads_per_rowgroup + d_tid_v < HSV / 4) {
                        gqaStore(row, d * threads_per_rowgroup + d_tid_v, Of[r][d], o_offset, iq2, N);
                    }
                }
            }
        }
    } else {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint row = tile_row(r);
            if (i * Br + row < N) {
                [[unroll]] for (uint32_t d = 0; d < of_elements; ++d) {
                    if (!of_bounds_check || d * threads_per_rowgroup + d_tid_v < HSV / 4) {
                        data_ov4[o_offset + (iq2 * HSV + (i * Br + row) * p.ne1 * HSV) / 4 + d * threads_per_rowgroup + d_tid_v] = D_TYPEV4(Of[r][d]);
                    }
                }
            }
        }
    }
}
